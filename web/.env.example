# Supabase (bekleme listesi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paddle ödeme. Ortam: "production" (canlı) ya da "sandbox" (deneme). Boş bırakılırsa /satin-al hata verir.
NEXT_PUBLIC_PADDLE_ENV=production
# Paddle > Developer tools > Authentication > Client-side tokens. Canlıda live_, denemede test_ ile başlar.
# Tarayıcıya gider, gizli değildir. Sunucu API anahtarını (pdl_...) buraya ya da NEXT_PUBLIC_ ile başlayan
# hiçbir değişkene yazmayın.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# --- Yalnızca sunucu (NEXT_PUBLIC_ ile BAŞLAMAZ, tarayıcıya gitmez) ---
# Supabase > Project settings > API > service_role. Lisans tablolarına (sp_*) yalnızca sunucu yazar.
SUPABASE_SERVICE_ROLE_KEY=
# Paddle > Developer tools > Notifications > hedef (https://www.ostlertech.com/api/paddle/webhook) > Secret key.
PADDLE_WEBHOOK_SECRET=
# Lisans imzalama anahtarı (Ed25519, PKCS8 DER, base64). Ortak anahtarı masaüstü uygulamasında gömülüdür;
# değişirse uygulamadaki LicenseManager.PUBLIC_KEY de değişmeli.
LICENSE_SIGNING_KEY=
